// ================================================================
// USTALAR TOPISH — Prisma Schema
// PostgreSQL | UUID Primary Keys | UTC Timestamps | Soft Delete
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
}

// ================================================================
// ENUMS
// ================================================================

enum UserRole {
  USER
  WORKER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum NotificationType {
  SYSTEM
  APPROVAL
  REJECTION
  REPORT
  BROADCAST
}

/// Review moduli hozircha FEATURE FLAG bilan o'chirilgan (Part 3: "Future Feature").
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ================================================================
// USER
// ================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  telegramId   String    @unique
  username     String?   @unique
  firstName    String
  lastName     String?
  languageCode String?   @default("uz")
  photoUrl     String?
  role         UserRole  @default(USER)
  isBlocked    Boolean   @default(false)
  notificationsEnabled Boolean @default(true)
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  worker Worker?

  notifications   Notification[]
  reportsFiled    Report[]           @relation("ReporterReports")
  reportsReviewed Report[]           @relation("ReviewedByModerator")
  favorites       Favorite[]
  reviews         Review[]
  viewHistories   ViewHistory[]
  searchHistories SearchHistory[]
  adminLogs       AdminLog[]
  broadcasts      BroadcastHistory[]
  approvedWorkers Worker[]           @relation("ApprovedByAdmin")

  @@index([role])
  @@index([isBlocked])
  @@index([createdAt])
  @@map("users")
}

// ================================================================
// WORKER
// ================================================================

model Worker {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @db.Uuid
  categoryId        String       @db.Uuid
  regionId          String       @db.Uuid
  districtId        String       @db.Uuid
  villageId         String?      @db.Uuid
  firstName         String
  lastName          String
  age               Int
  phone             String       @unique
  telegramUsername  String?
  description       String
  experienceYears   Int
  address           String
  latitude          Float
  longitude         Float
  workingHoursStart String
  workingHoursEnd   String
  status            WorkerStatus @default(PENDING)
  views             Int          @default(0)
  isVerified        Boolean      @default(false)
  approvedBy        String?      @db.Uuid
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  region          Region    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district        District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  village         Village?  @relation(fields: [villageId], references: [id], onDelete: SetNull)
  approvedByAdmin User?     @relation("ApprovedByAdmin", fields: [approvedBy], references: [id], onDelete: SetNull)

  portfolioImages PortfolioImage[]
  reports         Report[]         @relation("WorkerReports")
  favorites       Favorite[]
  reviews         Review[]
  viewHistories   ViewHistory[]

  @@index([categoryId])
  @@index([regionId])
  @@index([districtId])
  @@index([villageId])
  @@index([status])
  @@index([views])
  @@index([createdAt])
  @@index([status, categoryId, regionId])
  @@map("workers")
}

// ================================================================
// CATEGORY
// ================================================================

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  icon       String?
  sortOrder  Int       @default(0)
  isVisible  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  workers         Worker[]
  searchHistories SearchHistory[]

  @@index([isVisible])
  @@index([sortOrder])
  @@map("categories")
}

// ================================================================
// REGION / DISTRICT / VILLAGE (Geo hierarchy)
// ================================================================

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts       District[]
  workers         Worker[]
  searchHistories SearchHistory[]

  @@map("regions")
}

model District {
  id        String   @id @default(uuid()) @db.Uuid
  regionId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region          Region          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  villages        Village[]
  workers         Worker[]
  searchHistories SearchHistory[]

  @@index([regionId])
  @@map("districts")
}

model Village {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @db.Uuid
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  workers  Worker[]

  @@index([districtId])
  @@map("villages")
}

// ================================================================
// PORTFOLIO IMAGES
// ================================================================

model PortfolioImage {
  id        String   @id @default(uuid()) @db.Uuid
  workerId  String   @db.Uuid
  imageUrl  String
  publicId  String
  width     Int
  height    Int
  size      Int
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("portfolio_images")
}

// ================================================================
// REPORTS
// ================================================================

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  workerId    String       @db.Uuid
  reporterId  String       @db.Uuid
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?      @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  worker   Worker @relation("WorkerReports", fields: [workerId], references: [id], onDelete: Restrict)
  reporter User   @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("ReviewedByModerator", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([workerId])
  @@index([reporterId])
  @@index([createdAt])
  @@map("reports")
}

// ================================================================
// NOTIFICATIONS
// ================================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ================================================================
// BROADCAST HISTORY
// ================================================================

model BroadcastHistory {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  title        String
  message      String
  image        String?
  buttonText   String?
  buttonUrl    String?
  successCount Int       @default(0)
  failedCount  Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("broadcast_history")
}

// ================================================================
// FAVORITES (Future Feature — backend tayyor, UI feature flag orqali yoqiladi)
// ================================================================

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  workerId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([userId, workerId])
  @@index([userId])
  @@index([workerId])
  @@map("favorites")
}

// ================================================================
// REVIEWS (Future Feature — backend tayyor, feature flag orqali o'chirilgan)
// ================================================================

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  workerId  String       @db.Uuid
  userId    String       @db.Uuid
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workerId, userId])
  @@index([workerId])
  @@index([status])
  @@map("reviews")
}

// ================================================================
// SETTINGS (bitta qatordan iborat global konfiguratsiya)
// ================================================================

model Settings {
  id                  String   @id @default(uuid()) @db.Uuid
  telegramChannel     String?
  supportUsername     String?
  maintenanceMode     Boolean  @default(false)
  appVersion          String   @default("1.0.0")
  minSupportedVersion String   @default("1.0.0")
  privacyPolicy       String?
  termsOfService      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("settings")
}

// ================================================================
// ADMIN LOGS (o'zgarmas audit yozuvlari — hech qachon edit/delete qilinmaydi)
// ================================================================

model AdminLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @db.Uuid
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_logs")
}

// ================================================================
// SEARCH HISTORY (Future analytics)
// ================================================================

model SearchHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  keyword    String?
  categoryId String?  @db.Uuid
  regionId   String?  @db.Uuid
  districtId String?  @db.Uuid
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  region   Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([keyword])
  @@map("search_history")
}

// ================================================================
// VIEW HISTORY (Profil analitikasi — xom IP hech qachon saqlanmaydi)
// ================================================================

model ViewHistory {
  id        String   @id @default(uuid()) @db.Uuid
  workerId  String   @db.Uuid
  viewerId  String?  @db.Uuid
  ipHash    String?
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  viewer User?  @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([createdAt])
  @@map("view_history")
}
