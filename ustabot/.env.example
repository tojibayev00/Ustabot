########################################
# USTALAR TOPISH — ENVIRONMENT VARIABLES
# Bu fayl namuna. Haqiqiy qiymatlarni .env fayliga yozing.
# .env hech qachon Git'ga commit qilinmasin.
########################################

# ---------- APP ----------
NODE_ENV=development
APP_NAME="Ustalar Topish"
APP_VERSION=1.0.0

# ---------- BACKEND SERVER ----------
PORT=4000
API_PREFIX=/api/v1
WEBAPP_URL=https://your-miniapp-domain.com
ADMIN_PANEL_URL=https://admin.your-domain.com
CORS_ORIGINS=https://your-miniapp-domain.com,https://admin.your-domain.com

# ---------- DATABASE (PostgreSQL) ----------
DATABASE_URL="postgresql://ustalar:ustalar_password@localhost:5432/ustalar_db?schema=public"
DATABASE_SHADOW_URL="postgresql://ustalar:ustalar_password@localhost:5432/ustalar_shadow_db?schema=public"

# ---------- REDIS ----------
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX="ustalar:"

# ---------- JWT ----------
JWT_SECRET="replace-with-a-long-random-secret-min-64-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-min-64-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ---------- TELEGRAM BOT ----------
TELEGRAM_BOT_TOKEN="000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_BOT_USERNAME="ustalar_topish_bot"
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET="replace-with-random-secret"
SUPER_ADMIN_IDS="111111111,222222222"
CHANNEL_URL="https://t.me/ustalar_topish_channel"
SUPPORT_USERNAME="ustalar_support"

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="ustalar-topish"

# ---------- INTERNAL (Bot <-> Backend) ----------
INTERNAL_API_KEY="replace-with-a-long-random-secret-min-32-chars"
BACKEND_API_URL="http://localhost:4000/api/v1"

# ---------- RATE LIMIT ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_REPORT_MAX=20

# ---------- LOGGING ----------
LOG_LEVEL="info"

# ---------- MINI APP (Vite) ----------
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_APP_NAME="Ustalar Topish"

# ---------- DOCKER / INFRA ----------
POSTGRES_USER=ustalar
POSTGRES_PASSWORD=ustalar_password
POSTGRES_DB=ustalar_db
POSTGRES_PORT=5432
REDIS_PORT=6379
